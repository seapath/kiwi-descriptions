[project]
org='seapath'
name='seapath-kiwi'

[build]
command='sudo kiwi-ng --help'

[clean]
command='sudo rm -rf \
    build \
    *.changes \
    *.install.iso \
    *.packages \
    *.raw \
    *.raw.bmap \
    *.raw.gz \
    *.verified \
    kiwi.result*
'

[leap16-seapath-observer]
distro='leap16.0'
command='./build.sh -f "openSUSE Leap" -p observer kiwi-descriptions/x86_64/leap/seapath-leap16.0'

[leap16-seapath-hypervisor-standalone]
distro='leap16.0'
command='./build.sh -f "openSUSE Leap" -p hypervisor kiwi-descriptions/x86_64/leap/seapath-leap16.0'

[leap16-seapath-hypervisor-standalone-cockpit]
distro='leap16.0'
command='./build.sh -f "openSUSE Leap" -p hypervisor -p cockpit kiwi-descriptions/x86_64/leap/seapath-leap16.0'

[leap16-seapath-hypervisor-cluster]
distro='leap16.0'
command='./build.sh -f "openSUSE Leap" -p hypervisor -p cluster kiwi-descriptions/x86_64/leap/seapath-leap16.0'

[leap16-seapath-hypervisor-cluster-cockpit]
distro='leap16.0'
command='./build.sh -f "openSUSE Leap" -p hypervisor -p cluster -p cockpit kiwi-descriptions/x86_64/leap/seapath-leap16.0'

[sles16-seapath-observer]
distro='sles16.0'
command='./build.sh -p observer -s kiwi-descriptions/x86_64/sle/seapath-sles16.0'

[sles16-seapath-hypervisor-standalone]
distro='sles16.0'
command='./build.sh -p hypervisor -s kiwi-descriptions/x86_64/sle/seapath-sles16.0'

[sles16-seapath-hypervisor-standalone-cockpit]
distro='sles16.0'
command='./build.sh -p hypervisor -p cockpit -s kiwi-descriptions/x86_64/sle/seapath-sles16.0'

[sles16-seapath-hypervisor-cluster]
distro='sles16.0'
command='./build.sh -p hypervisor -p cluster -s kiwi-descriptions/x86_64/sle/seapath-sles16.0'

[sles16-seapath-hypervisor-cluster-cockpit]
distro='sles16.0'
command='./build.sh -p hypervisor -p cluster -p cockpit -s kiwi-descriptions/x86_64/sle/seapath-sles16.0'
